# syntax=docker/dockerfile:1
# CV (listepo/cv) static site + PDF, served by nginx on :80. Context = repo checkout.
FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends chromium && rm -rf /var/lib/apt/lists/*
ENV CHROME_PATH=/usr/bin/chromium CI=true SITE_URL=https://cv.test-env.click SITE_BASE=/ GA_MEASUREMENT_ID=off POSTHOG_KEY=
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build && test -f dist/index.html

FROM nginx:1.30-alpine
COPY docker/paas-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
