---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Prompt from '../components/Prompt.astro';
import { about, facts, stack, projects, statusLabel, experience, links, contactTodos, person, site } from '../data/cv';

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
const year = new Date().getFullYear();
const isLiteral = (v: string) => /^\d+$|^true$|^false$/.test(v);
---
<Base>
  <Nav />
  <main id="main">
    <Hero />

    <!-- about -->
    <section id="about" class="section container-x reveal" aria-labelledby="about-title">
      <div class="section-head">
        <Prompt num="01" cmd="cat about.md" />
        <h2 id="about-title" class="section-title" data-glitch>Обо мне</h2>
      </div>
      <div class="about">
        <div class="about__text">
          {about.map((p) => <p>{p}</p>)}
          <p class="text-sm text-muted">Локация: <span class="todo">{person.location}</span></p>
        </div>
        <aside class="pane about__facts" aria-label="Коротко">
          <div class="pane__tab"><b>profile.toml</b><span>toml</span></div>
          <dl class="kv mono">
            {facts.map((f, i) => (
              <div>
                <span class="kv__ln" aria-hidden="true">{i + 1}</span>
                <dt>{f.key}</dt>
                <dd><span class="text-subtle">=</span> <span class={isLiteral(f.value) ? 'text-fg-strong' : 'text-accent'}>{isLiteral(f.value) ? f.value : `"${f.value}"`}</span></dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    <!-- stack -->
    <section id="stack" class="section container-x reveal" aria-labelledby="stack-title">
      <div class="section-head">
        <Prompt num="02" cmd="ls ~/stack" />
        <h2 id="stack-title" class="section-title" data-glitch>Стек</h2>
        <p class="section-lede">Языки и инструменты, на которых написаны мои проекты.</p>
      </div>
      <div class="stack pane">
        {stack.map((g) => (
          <div class="stack__group">
            <p class="stack__label mono">{g.group}/</p>
            <ul class="stack__items">{g.items.map((i) => <li class="tag">{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <!-- projects -->
    <section id="projects" class="section container-x reveal" aria-labelledby="projects-title">
      <div class="section-head">
        <Prompt num="03" cmd="ls -la ~/projects" />
        <h2 id="projects-title" class="section-title" data-glitch>Проекты</h2>
        <p class="section-lede">Основные — CLI и AI-инструменты на Rust. Ниже — остальные открытые репозитории.</p>
      </div>

      <ul class="featured" role="list">
        {featured.map((p, i) => (
          <li class="pane tilt project" data-tilt="3">
            <div class="tilt__lift">
              <div class="project__head">
                <span class="project__idx mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="project__name mono">{p.name}</h3>
                <span class={`status status--${p.status}`}>{statusLabel[p.status]}</span>
              </div>
              <p class="project__summary">{p.summary}</p>
              <div class="project__foot mono">
                <code class="project__cmd"><span class="text-accent">❯</span> {p.cmd}</code>
                <a class="project__link" href={`https://github.com/${p.repo}`} target="_blank" rel="noopener">
                  <span class="sr-only">{p.name} на GitHub (откроется в новой вкладке)</span><span aria-hidden="true">{p.repo} ↗</span>
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>

      <div class="pane ls" role="region" aria-label="Остальные репозитории">
        <div class="pane__tab"><b>~/projects</b><span>{rest.length} entries</span></div>
        <ul role="list">
          {rest.map((p) => (
            <li>
              <a class="ls__row" href={`https://github.com/${p.repo}`} target="_blank" rel="noopener">
                <span class="ls__perm mono" aria-hidden="true">drwxr-xr-x</span>
                <span class="ls__name mono">{p.name}/</span>
                <span class="ls__lang mono">{p.lang}</span>
                <span class="ls__desc">{p.summary}</span>
                <span class={`status status--${p.status} ls__status`}>{statusLabel[p.status]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- experience -->
    <section id="experience" class="section container-x reveal" aria-labelledby="exp-title">
      <div class="section-head">
        <Prompt num="04" cmd="git log --author=ivan --oneline" />
        <h2 id="exp-title" class="section-title" data-glitch>Опыт</h2>
        <p class="section-lede">История работы пока не заполнена — места для данных помечены <span class="todo">TODO</span>.</p>
      </div>
      <ol class="log pane">
        {experience.map((j, i) => (
          <li class="log__item">
            <span class="log__hash mono" aria-hidden="true">{['a1f3c9e', '7d20b4f', '3e9c01a'][i] ?? '0000000'}</span>
            <div class="log__body">
              <h3 class="log__title">
                <span class={j.title.startsWith('TODO') ? 'todo' : ''}>{j.title}</span>
                <span class="text-subtle"> @ </span>
                <span class={j.org.startsWith('TODO') ? 'todo' : ''}>{j.org}</span>
              </h3>
              <p class="log__note"><span class={j.note.startsWith('TODO') ? 'todo' : ''}>{j.note}</span></p>
            </div>
            <p class="log__period mono"><span class={j.period.startsWith('TODO') ? 'todo' : ''}>{j.period}</span></p>
          </li>
        ))}
        <li class="log__item log__item--root">
          <span class="log__hash mono" aria-hidden="true">0c0ffee</span>
          <p class="log__body mono text-sm text-muted">init: аккаунт на GitHub</p>
          <p class="log__period mono">{person.githubSince}</p>
        </li>
      </ol>
    </section>

    <!-- contact -->
    <section id="contact" class="section container-x reveal" aria-labelledby="contact-title">
      <div class="section-head">
        <Prompt num="05" cmd="cat contacts" />
        <h2 id="contact-title" class="section-title" data-glitch>Связаться</h2>
        <p class="section-lede">Открыт к предложениям. Ссылки на профили — ниже; email и мессенджеры будут добавлены позже.</p>
      </div>
      <ul class="contact pane" role="list">
        {links.map((l) => (
          <li>
            <a class="contact__row" href={l.href} target="_blank" rel="me noopener">
              <span class="contact__key mono">{l.label.toLowerCase()}</span>
              <span class="contact__val mono">{l.value}</span>
              <span class="contact__arrow" aria-hidden="true">↗</span>
              <span class="sr-only">(откроется в новой вкладке)</span>
            </a>
          </li>
        ))}
        {contactTodos.map((c) => (
          <li>
            <span class="contact__row contact__row--disabled" aria-disabled="true">
              <span class="contact__key mono">{c.label.toLowerCase()}</span>
              <span class="contact__val"><span class="todo">{c.value}</span></span>
            </span>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer class="footer container-x">
    <p class="mono footer__mark">{site.domain}<span class="footer__cursor" aria-hidden="true"></span></p>
    <p class="mono text-muted">© {year} {person.name}</p>
    <a class="footer__top mono" href="#top">cd ~ <span aria-hidden="true">↑</span></a>
  </footer>
</Base>

<script>
  import '../scripts/main.ts';
</script>

<style>
  .section { padding-block: var(--space-20); }
  @media (min-width: 768px) { .section { padding-block: var(--space-24); } }

  /* about */
  .about { display: grid; gap: var(--space-8); margin-top: var(--space-8); }
  @media (min-width: 900px) { .about { grid-template-columns: 1.5fr 1fr; gap: var(--space-12); } }
  .about__text { display: grid; gap: var(--space-4); max-width: 40rem; font-size: var(--text-lg); color: var(--fg); }
  .about__text p:not(:first-child):not(:last-child) { color: var(--muted); }
  .about__facts { align-self: start; overflow: hidden; }
  .kv { display: grid; padding: var(--space-3) 0; font-size: var(--text-sm); }
  .kv div { display: flex; gap: var(--space-3); padding: 2px var(--space-4); }
  .kv__ln { width: 2ch; text-align: right; color: var(--subtle); }
  .kv dt { color: var(--fg); min-width: 12ch; }

  /* stack: one pane, four columns */
  .stack { display: grid; margin-top: var(--space-8); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .stack__group { padding: var(--space-5) var(--space-6) var(--space-6); border-top: 1px solid var(--line); margin-top: -1px; }
  @media (min-width: 640px) { .stack__group + .stack__group { border-left: 1px solid var(--line); } }
  .stack__label { font-size: var(--text-xs); color: var(--subtle); margin-bottom: var(--space-3); }
  .stack__items { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  /* projects */
  .featured { display: grid; gap: var(--space-4); margin-top: var(--space-8); }
  @media (min-width: 768px) { .featured { grid-template-columns: repeat(2, 1fr); } }
  .project { padding: var(--space-6); }
  .project__head { display: flex; align-items: baseline; gap: var(--space-3); }
  .project__idx { font-size: var(--text-xs); color: var(--subtle); }
  .project__name { font-size: var(--text-xl); font-weight: 600; letter-spacing: -0.03em; }
  .project__head .status { margin-left: auto; }
  .project__summary { margin-top: var(--space-3); color: var(--muted); min-height: 4.8em; }
  .project__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px dashed var(--line-strong); }
  .project__cmd { font-size: var(--text-sm); color: var(--fg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .project__link { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-xs); color: var(--muted); white-space: nowrap; transition: color var(--dur-fast); }
  .project__link::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius-lg); }
  .project__link:hover { color: var(--accent); }
  .project:has(.project__link:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .project__link:focus-visible { outline: none; }

  .ls { margin-top: var(--space-4); overflow: hidden; }
  .ls__row {
    display: grid; gap: var(--space-1) var(--space-4); align-items: baseline;
    grid-template-columns: 1fr auto; grid-template-areas: "name status" "desc desc";
    padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .ls li:last-child .ls__row { border-bottom: 0; }
  .ls__row:hover { background: var(--accent-soft); }
  .ls__row:hover .ls__name { color: var(--accent); }
  .ls__row:focus-visible { outline-offset: -2px; border-radius: 0; }
  .ls__perm, .ls__lang { display: none; }
  .ls__name { grid-area: name; color: var(--fg-strong); font-size: var(--text-sm); font-weight: 600; transition: color var(--dur-fast); }
  .ls__desc { grid-area: desc; color: var(--muted); font-size: var(--text-sm); }
  .ls__status { grid-area: status; }
  @media (min-width: 900px) {
    .ls__row { grid-template-columns: 10ch 16ch 10ch 1fr 10ch; grid-template-areas: "perm name lang desc status"; }
    .ls__perm { display: block; grid-area: perm; color: var(--subtle); font-size: var(--text-xs); }
    .ls__lang { display: block; grid-area: lang; color: var(--muted); font-size: var(--text-xs); }
  }

  /* experience: git-log table inside one pane */
  .log { margin-top: var(--space-8); overflow: hidden; }
  .log__item { display: grid; grid-template-columns: 8ch 1fr; gap: var(--space-1) var(--space-4); padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--line); }
  .log__item:last-child { border-bottom: 0; }
  .log__hash { font-size: var(--text-xs); color: var(--accent); padding-top: 4px; }
  .log__period { grid-column: 2; font-size: var(--text-xs); color: var(--muted); }
  .log__title { font-size: var(--text-lg); font-weight: 600; }
  .log__note { margin-top: var(--space-1); color: var(--muted); }
  .log__item--root .log__hash { color: var(--subtle); padding-top: 0; }
  @media (min-width: 768px) {
    .log__item { grid-template-columns: 9ch 1fr auto; }
    .log__period { grid-column: 3; grid-row: 1; text-align: right; padding-top: 4px; }
  }

  /* contact: list pane, two columns */
  .contact { margin-top: var(--space-8); display: grid; overflow: hidden; }
  @media (min-width: 768px) { .contact { grid-template-columns: 1fr 1fr; } .contact li:nth-child(odd) { border-right: 1px solid var(--line); } }
  .contact li { border-bottom: 1px solid var(--line); }
  .contact__row { display: flex; align-items: center; gap: var(--space-4); min-height: 60px; padding: 0 var(--space-6); transition: background-color var(--dur-base) var(--ease-out); }
  a.contact__row:hover { background: var(--accent-soft); }
  a.contact__row:focus-visible { outline-offset: -2px; border-radius: 0; }
  .contact__row--disabled { cursor: not-allowed; }
  .contact__key { min-width: 9ch; font-size: var(--text-xs); color: var(--subtle); }
  .contact__val { font-size: var(--text-sm); color: var(--fg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .contact__arrow { margin-left: auto; color: var(--muted); transition: color var(--dur-fast), transform var(--dur-base) var(--ease-out); }
  a.contact__row:hover .contact__arrow { color: var(--accent); transform: translate(2px, -2px); }

  /* footer */
  .footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-10) var(--space-12); border-top: 1px solid var(--line); font-size: var(--text-sm); color: var(--muted); }
  .footer__mark { display: inline-flex; align-items: center; gap: 6px; color: var(--fg-strong); font-weight: 600; }
  .footer__cursor { width: 8px; height: 16px; background: var(--accent); }
  .footer__top { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-3); border-radius: var(--radius-sm); color: var(--muted); }
  .footer__top:hover { color: var(--accent); }
</style>
