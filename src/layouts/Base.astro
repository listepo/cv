---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site, person } from '../data/cv';

const canonical = new URL(Astro.url.pathname, site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  alternateName: person.handle,
  url: site.url,
  jobTitle: 'Engineer',
  sameAs: ['https://github.com/listepo', 'https://x.com/listepo', 'https://www.linkedin.com/in/ivan-tugay-68101474/'],
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0c0f" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="profile:username" content={person.handle} />
    <!-- TODO: og:image — 1200×630 PNG at https://listepo.dev/og.png -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@listepo" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <div class="backdrop" aria-hidden="true"></div>
    <slot />
  </body>
</html>
