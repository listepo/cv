---
import '../styles/fonts.css';
import '../styles/global.css';
import { site, person } from '../data/cv';

interface Props {
  title?: string;
  description?: string;
  /** Crawler directive. The 404 page sets `noindex` so it stays out of search and any sitemap. */
  robots?: string;
}

const { title = site.title, description = site.description, robots } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = site.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  alternateName: person.handle,
  url: site.url,
  jobTitle: 'CTO',
  worksFor: { '@type': 'Organization', name: 'Pyrlyn', url: 'https://github.com/pyrlyn' },
  email: 'mailto:listepo@gmail.com',
  address: { '@type': 'PostalAddress', addressCountry: 'UA' },
  sameAs: ['https://github.com/listepo', 'https://x.com/listepo', 'https://www.linkedin.com/in/listepo'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f0e8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0a09" />
    <meta name="color-scheme" content="dark light" />
    <!-- theme before first paint (no flash): saved choice → prefers-color-scheme; keeps theme-color in sync -->
    <script is:inline>
      (function () {
        var s = null;
        try { s = localStorage.getItem('cv:theme'); } catch (e) {}
        var manual = s === 'light' || s === 'dark';
        var t = manual ? s : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        var d = document.documentElement;
        d.setAttribute('data-theme', t);
        d.style.colorScheme = t;
        if (manual) {
          var m = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < m.length; i++) m[i].setAttribute('content', t === 'light' ? '#f4f0e8' : '#0b0a09');
        }
      })();
    </script>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="listepo" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="profile:username" content={person.handle} />
    <!-- TODO: og:image — 1200×630 PNG at public/og.png -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@listepo" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="backdrop" aria-hidden="true"></div>
    <canvas class="rain" id="rain" aria-hidden="true"></canvas>
    <div class="scanlines" aria-hidden="true"></div>
    <slot />
  </body>
</html>
