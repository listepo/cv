---
import '../styles/fonts.css';
import '../styles/global.css';
import { site, person, projects } from '../data/cv';
import { serializeJsonLd } from '../data/json-ld';

interface Props {
  title?: string;
  description?: string;
  /** Crawler directive. The 404 page sets `noindex` so it stays out of search and any sitemap. */
  robots?: string;
}

const { title = site.title, description = site.description, robots } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = site.url;
const ogImage = new URL('og.png', site.url).href;
const ogAlt = 'Ivan Tuhai, founder & CTO of Pyrlyn — ketch, rtok, runa, cox';
const person_ = {
  '@type': 'Person',
  '@id': `${site.url}#person`,
  name: person.name,
  alternateName: person.handle,
  url: site.url,
  description,
  jobTitle: 'CTO',
  worksFor: { '@type': 'Organization', name: 'Pyrlyn', url: 'https://github.com/pyrlyn' },
  email: 'mailto:listepo@gmail.com',
  address: { '@type': 'PostalAddress', addressCountry: 'UA' },
  sameAs: ['https://github.com/listepo', 'https://x.com/listepo', 'https://www.linkedin.com/in/listepo'],
};
// Only the four Pyrlyn products named in the title; text comes from src/data/cv.ts. No ratings, prices or versions.
const software = projects
  .filter((p) => p.featured)
  .map((p) => ({
    '@type': 'SoftwareApplication',
    name: p.name,
    description: p.summary,
    url: `https://github.com/${p.repo}`,
    applicationCategory: 'DeveloperApplication',
    // Only ketch states its platforms on the site.
    ...(p.name === 'ketch' && { operatingSystem: 'macOS, Linux, Windows' }),
    author: { '@id': person_['@id'] },
  }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: site.url,
  name: title,
  description,
  mainEntity: person_,
  hasPart: software,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f0e8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0a09" />
    <meta name="color-scheme" content="dark light" />
    <!-- theme before first paint (no flash): saved choice → prefers-color-scheme; keeps theme-color in sync -->
    <script is:inline>
      (function () {
        var s = null;
        try { s = localStorage.getItem('cv:theme'); } catch (e) {}
        var manual = s === 'light' || s === 'dark';
        var t = manual ? s : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        var d = document.documentElement;
        d.setAttribute('data-theme', t);
        d.style.colorScheme = t;
        if (manual) {
          var m = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < m.length; i++) m[i].setAttribute('content', t === 'light' ? '#f4f0e8' : '#0b0a09');
        }
      })();
    </script>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="listepo" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="profile:username" content={person.handle} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@listepo" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="backdrop" aria-hidden="true"></div>
    <canvas class="rain" id="rain" aria-hidden="true"></canvas>
    <div class="scanlines" aria-hidden="true"></div>
    <slot />
  </body>
</html>
