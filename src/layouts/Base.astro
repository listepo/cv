---
import '../styles/fonts.css';
import '../styles/global.css';
import { site, person, projects } from '../data/cv';
// Public GA4 ID (same as pyrlyn landing); override with GA_MEASUREMENT_ID, or set it to "off" to disable.
const gaRaw = (import.meta.env.GA_MEASUREMENT_ID ?? process.env.GA_MEASUREMENT_ID ?? '').trim() || 'G-J0GY03RN5H';
const GA_MEASUREMENT_ID = /^G-[A-Z0-9]+$/.test(gaRaw) ? gaRaw : '';
// Public PostHog project key (phc_...); empty = PostHog off. Host defaults to the EU cloud.
const phRaw = (import.meta.env.POSTHOG_KEY ?? process.env.POSTHOG_KEY ?? '').trim();
const POSTHOG_KEY = /^phc_[A-Za-z0-9]+$/.test(phRaw) ? phRaw : '';
const POSTHOG_HOST = (import.meta.env.POSTHOG_HOST ?? process.env.POSTHOG_HOST ?? '').trim() || 'https://eu.i.posthog.com';

interface Props {
  title?: string;
  description?: string;
  /** Crawler directive. The 404 page sets `noindex` so it stays out of search and any sitemap. */
  robots?: string;
}

const { title = site.title, description = site.description, robots } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = site.url;
const ogImage = new URL('og.png', site.url).href;
const ogAlt = 'Ivan Tuhai, founder & CTO of Pyrlyn — ketch, rtok, runa, cox';
const person_ = {
  '@type': 'Person',
  '@id': `${site.url}#person`,
  name: person.name,
  alternateName: person.handle,
  url: site.url,
  description,
  jobTitle: 'CTO',
  worksFor: { '@type': 'Organization', name: 'Pyrlyn', url: 'https://github.com/pyrlyn' },
  email: 'mailto:listepo@gmail.com',
  address: { '@type': 'PostalAddress', addressCountry: 'UA' },
  sameAs: ['https://github.com/listepo', 'https://x.com/listepo', 'https://www.linkedin.com/in/listepo'],
};
// Only the four Pyrlyn products named in the title; text comes from src/data/cv.ts. No ratings, prices or versions.
const software = projects
  .filter((p) => p.featured)
  .map((p) => ({
    '@type': 'SoftwareApplication',
    name: p.name,
    description: p.summary,
    url: `https://github.com/${p.repo}`,
    applicationCategory: 'DeveloperApplication',
    // Only ketch states its platforms on the site.
    ...(p.name === 'ketch' && { operatingSystem: 'macOS, Linux, Windows' }),
    author: { '@id': person_['@id'] },
  }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: site.url,
  name: title,
  description,
  mainEntity: person_,
  hasPart: software,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f0e8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0a09" />
    <meta name="color-scheme" content="dark light" />
    <!-- theme before first paint (no flash): saved choice → prefers-color-scheme; keeps theme-color in sync -->
    <script is:inline>
      (function () {
        var s = null;
        try { s = localStorage.getItem('cv:theme'); } catch (e) {}
        var manual = s === 'light' || s === 'dark';
        var t = manual ? s : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        var d = document.documentElement;
        d.setAttribute('data-theme', t);
        d.style.colorScheme = t;
        if (manual) {
          var m = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < m.length; i++) m[i].setAttribute('content', t === 'light' ? '#f4f0e8' : '#0b0a09');
        }
      })();
    </script>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="listepo" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="profile:username" content={person.handle} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@listepo" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {GA_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag("js",new Date());gtag("config",gaId);</script>
      </>
    )}
    {POSTHOG_KEY && (
      <script is:inline define:vars={{ phKey: POSTHOG_KEY, phHost: POSTHOG_HOST }}>!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once unregister identify alias reset opt_in_capturing opt_out_capturing has_opted_out_capturing get_distinct_id getFeatureFlag isFeatureEnabled onFeatureFlags".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);posthog.init(phKey,{api_host:phHost,person_profiles:"identified_only"});</script>
    )}
  </head>
  <body>
    <a class="skip-link absolute left-4 -top-[100px] z-100 px-4 py-2 rounded-sm bg-accent-fill text-accent-ink font-semibold focus:top-4" href="#main">Skip to content</a>
    <div class="backdrop" aria-hidden="true"></div>
    <canvas class="rain" id="rain" aria-hidden="true"></canvas>
    <div class="scanlines" aria-hidden="true"></div>
    <slot />
  </body>
</html>
