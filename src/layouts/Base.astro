---
import '../styles/fonts.css';
import '../styles/global.css';
import { site, person } from '../data/cv';

const canonical = new URL(Astro.url.pathname, site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  alternateName: person.handle,
  url: site.url,
  jobTitle: 'CTO',
  worksFor: { '@type': 'Organization', name: 'Pyrlyn', url: 'https://github.com/pyrlyn' },
  email: 'mailto:listepo@gmail.com',
  address: { '@type': 'PostalAddress', addressCountry: 'UA' },
  sameAs: ['https://github.com/listepo', 'https://x.com/listepo', 'https://www.linkedin.com/in/listepo'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0a09" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="profile:username" content={person.handle} />
    <!-- TODO: og:image — 1200×630 PNG at https://listepo.dev/og.png -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@listepo" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="backdrop" aria-hidden="true"></div>
    <canvas class="rain" id="rain" aria-hidden="true"></canvas>
    <div class="scanlines" aria-hidden="true"></div>
    <slot />
  </body>
</html>
