---
import Prompt from './Prompt.astro';
import { person, projects } from '../data/cv';
const products = projects.slice(0, 5).map((p) => p.name);
// Static SVG fallback graph (no WebGL): seeded so every build renders the same picture.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const fbNodes = Array.from({ length: 64 }, (_, i) => {
  const r = 82 * Math.sqrt(rand()), a = rand() * Math.PI * 2;
  return { x: +(Math.cos(a) * r).toFixed(1), y: +(Math.sin(a) * r).toFixed(1), hub: i % 16 === 0 };
});
const fbEdges: Array<[number, number]> = [];
fbNodes.forEach((n, i) => {
  const near = fbNodes.map((m, j) => [j, (m.x - n.x) ** 2 + (m.y - n.y) ** 2] as const).filter(([j]) => j !== i).sort((p, q) => p[1] - q[1]);
  for (const [j] of near.slice(0, 2)) if (i < j) fbEdges.push([i, j]);
});
---
<section id="top" class="hero container-x" aria-labelledby="hero-title">
  <div class="hero__copy">
    <Prompt cmd="whoami" />
    <h1 id="hero-title" class="hero__title" data-glitch>{person.name}</h1>
    <p class="hero__role mono">
      <span class="text-fg">@{person.handle}</span><span class="text-subtle" aria-hidden="true">/</span><span>{person.role}</span>
      <span class="hero__open">open to offers</span>
    </p>
    <p class="hero__lede">
      {person.motto[0]}<br />
      <span class="text-fg">{person.motto[1]}</span>
    </p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="#projects"><span class="btn__label" data-glitch>View projects</span> <span aria-hidden="true">↓</span></a>
      <a class="btn btn--outline" href="https://github.com/listepo" rel="me noopener" target="_blank"><span class="btn__label" data-glitch>github.com/listepo</span><span class="sr-only"> (opens in a new tab)</span></a>
    </div>
  </div>

  <div class="hero__stage" aria-hidden="true">
    <div class="hero__3d" id="hero-3d" data-depth="12">
      <svg class="graph-fallback" viewBox="-100 -100 200 200">
        {fbEdges.map(([i, j]) => <line x1={fbNodes[i].x} y1={fbNodes[i].y} x2={fbNodes[j].x} y2={fbNodes[j].y} />)}
        {fbNodes.map((n) => <circle cx={n.x} cy={n.y} r={n.hub ? 2.6 : 1.6} class={n.hub ? 'is-hub' : ''} />)}
      </svg>
    </div>
    <div class="hero__pane frost" data-depth="30">
      <div class="pane__tab"><b>zsh</b><span>~/projects</span></div>
      <pre class="hero__pre"><span class="text-accent">❯</span> ls
{products.map((n) => <span class="hero__item">{n}</span>)}
<span class="text-accent">❯</span> <span class="cursor"></span></pre>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid; gap: var(--space-12); align-items: center;
    padding-top: var(--space-16); padding-bottom: var(--space-20);
    min-height: min(860px, calc(100svh - 56px));
  }
  @media (min-width: 960px) { .hero { grid-template-columns: 1.1fr .9fr; gap: var(--space-8); } }

  .hero__title {
    margin-top: var(--space-4);
    font-family: var(--font-mono); font-weight: 600;
    font-size: var(--text-display); line-height: .98; letter-spacing: -0.06em;
  }
  .hero__role { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); margin-top: var(--space-5); font-size: var(--text-base); color: var(--muted); }
  .hero__open {
    display: inline-flex; align-items: center; height: 26px; padding: 0 var(--space-2);
    border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-ink);
    font-size: var(--text-xs); font-weight: 600;
  }
  .hero__lede { margin-top: var(--space-6); max-width: 34rem; font-size: var(--text-lg); line-height: 1.6; color: var(--muted); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }

  /* load sequence (after the nav wordmark has typed itself): prompt → name → role → motto → buttons → graph.
     Fill mode "backwards" only, so nothing lingers after the ~0.9 s sequence (scroll parallax and hover keep working). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > * { animation: hero-in 450ms var(--ease-out) backwards; }
    .hero__copy > :nth-child(1) { animation-delay: 650ms; }
    .hero__copy > :nth-child(2) { animation-delay: 730ms; }
    .hero__copy > :nth-child(3) { animation-delay: 810ms; }
    .hero__copy > :nth-child(4) { animation-delay: 870ms; }
    .hero__copy > :nth-child(5) { animation-delay: 930ms; }
    .hero__copy :global(.prompt__cmd) { animation: hero-type 270ms steps(6, end) 720ms backwards; }
    .hero__stage { animation: hero-stage 550ms var(--ease-out) 990ms backwards; }
  }
  @keyframes hero-in { from { opacity: 0; translate: 0 12px; } }
  @keyframes hero-type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes hero-stage { from { opacity: 0; scale: .96; } }
  .hero__stage { position: relative; aspect-ratio: 1 / 1; width: 100%; max-width: 520px; margin-inline: auto; }
  @media (max-width: 959px) { .hero__stage { max-width: 400px; } }
  /* dark scrim so the rain recedes behind the 3D object */
  .hero__stage::before { content: ""; position: absolute; inset: 4%; border-radius: 50%; background: radial-gradient(closest-side, rgb(11 10 9 / .92), rgb(11 10 9 / .6) 70%, transparent); }
  .hero__3d { position: absolute; inset: 0; display: grid; place-items: center; }
  .hero__3d :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .hero__3d:global(.has-webgl) .graph-fallback { display: none; }
  .hero__3d { touch-action: manipulation; }

  .hero__pane {
    position: absolute; right: 0; bottom: 6%; width: min(250px, 64%);
    border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg);
    animation: float 9s var(--ease-out) infinite; transform: translate3d(0, var(--float), 0);
  }
  .hero__pre { padding: 12px 16px 14px; font-size: 12.5px; line-height: 1.75; color: var(--fg); white-space: pre-wrap; }
  .hero__item { display: inline-block; margin-right: 12px; }

  /* SVG fallback graph (shown until/unless WebGL mounts) */
  .graph-fallback { width: 86%; height: 86%; overflow: visible; }
  .graph-fallback line { stroke: rgb(236 231 223 / .2); stroke-width: .5; }
  .graph-fallback circle { fill: rgb(236 231 223 / .85); }
  .graph-fallback circle.is-hub { fill: var(--accent); }
</style>
