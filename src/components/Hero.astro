---
import Prompt from './Prompt.astro';
import { person, projects } from '../data/cv';
const products = projects.slice(0, 5).map((p) => p.name);
// static graphs for the CSS-3D fallback cube (shown when WebGL is unavailable)
const pts = (ys: number[]) => ys.map((y, i) => `${6 + (i * 88) / (ys.length - 1)},${y}`).join(' ');
const faces = [
  { side: 'f', kind: 'line', points: pts([70, 52, 60, 34, 46, 28, 40, 22]), bars: [], dots: [] },
  { side: 'r', kind: 'bar', points: '', bars: [30, 52, 40, 64, 76, 48, 58, 36], dots: [] },
  { side: 't', kind: 'scatter', points: '', bars: [], dots: [[14, 70], [26, 48], [34, 62], [46, 30], [52, 54], [64, 40], [72, 22], [84, 46], [40, 80], [78, 66]] },
  { side: 'b', kind: 'area', points: pts([66, 58, 70, 44, 50, 36, 42, 30]), bars: [], dots: [] },
  { side: 'l', kind: 'area', points: pts([50, 40, 58, 46, 30, 38, 24, 32]), bars: [], dots: [] },
  { side: 'd', kind: 'line', points: pts([40, 60, 34, 56, 44, 70, 52, 38]), bars: [], dots: [] },
];
---
<section id="top" class="hero container-x" aria-labelledby="hero-title">
  <div class="hero__copy">
    <Prompt cmd="whoami" />
    <h1 id="hero-title" class="hero__title" data-glitch>{person.name}</h1>
    <p class="hero__role mono">
      <span class="text-fg">@{person.handle}</span><span class="text-subtle" aria-hidden="true">/</span><span>{person.role}</span>
      <span class="hero__open">open to offers</span>
    </p>
    <p class="hero__lede">
      {person.motto[0]}<br />
      <span class="text-fg">{person.motto[1]}</span>
    </p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="#projects">View projects <span aria-hidden="true">↓</span></a>
      <a class="btn btn--outline" href="https://github.com/listepo" rel="me noopener" target="_blank">github.com/listepo<span class="sr-only"> (opens in a new tab)</span></a>
    </div>
  </div>

  <div class="hero__stage" aria-hidden="true">
    <div class="hero__3d" id="hero-3d" data-depth="12">
      <div class="cube-fallback">
        <div class="cube">
          {faces.map((f) => (
            <div class={`cube__face cube__face--${f.side}`}>
              <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                {f.kind === 'line' && <polyline points={f.points} fill="none" stroke="#ece7df" stroke-width="1.6" stroke-linejoin="round" />}
                {f.kind === 'area' && <><polygon points={`6,92 ${f.points} 94,92`} fill="rgb(200 240 49 / .22)" /><polyline points={f.points} fill="none" stroke="#c8f031" stroke-width="1.6" /></>}
                {f.kind === 'bar' && f.bars.map((b, i) => <rect x={8 + i * 11} y={92 - b} width="6" height={b} fill={i === 4 ? '#c8f031' : 'rgb(236 231 223 / .5)'} />)}
                {f.kind === 'scatter' && f.dots.map(([x, y], i) => <circle cx={x} cy={y} r="2" fill={i % 4 ? '#ece7df' : '#c8f031'} />)}
              </svg>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="hero__pane frost" data-depth="30">
      <div class="pane__tab"><b>zsh</b><span>~/projects</span></div>
      <pre class="hero__pre"><span class="text-accent">❯</span> ls
{products.map((n) => <span class="hero__item">{n}</span>)}
<span class="text-accent">❯</span> <span class="cursor"></span></pre>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid; gap: var(--space-12); align-items: center;
    padding-top: var(--space-16); padding-bottom: var(--space-20);
    min-height: min(860px, calc(100svh - 56px));
  }
  @media (min-width: 960px) { .hero { grid-template-columns: 1.1fr .9fr; gap: var(--space-8); } }

  .hero__title {
    margin-top: var(--space-4);
    font-family: var(--font-mono); font-weight: 600;
    font-size: var(--text-display); line-height: .98; letter-spacing: -0.06em;
  }
  .hero__role { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); margin-top: var(--space-5); font-size: var(--text-base); color: var(--muted); }
  .hero__open {
    display: inline-flex; align-items: center; height: 26px; padding: 0 var(--space-2);
    border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-ink);
    font-size: var(--text-xs); font-weight: 600;
  }
  .hero__lede { margin-top: var(--space-6); max-width: 34rem; font-size: var(--text-lg); line-height: 1.6; color: var(--muted); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }

  .hero__stage { position: relative; aspect-ratio: 1 / 1; width: 100%; max-width: 520px; margin-inline: auto; }
  @media (max-width: 959px) { .hero__stage { max-width: 400px; } }
  /* dark scrim so the rain recedes behind the 3D object */
  .hero__stage::before { content: ""; position: absolute; inset: 4%; border-radius: 50%; background: radial-gradient(closest-side, rgb(11 10 9 / .92), rgb(11 10 9 / .6) 70%, transparent); }
  .hero__3d { position: absolute; inset: 0; display: grid; place-items: center; }
  .hero__3d :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .hero__3d:global(.has-webgl) .cube-fallback { display: none; }
  .hero__3d { touch-action: manipulation; }

  .hero__pane {
    position: absolute; right: 0; bottom: 6%; width: min(250px, 64%);
    border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg);
    animation: float 9s var(--ease-out) infinite; transform: translate3d(0, var(--float), 0);
  }
  .hero__pre { padding: 12px 16px 14px; font-size: 12.5px; line-height: 1.75; color: var(--fg); white-space: pre-wrap; }
  .hero__item { display: inline-block; margin-right: 12px; }

  /* CSS-3D fallback cube with static graphs */
  .cube-fallback { width: 46%; aspect-ratio: 1; perspective: 1000px; container-type: inline-size; }
  .cube { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transform: rotateX(-24deg) rotateY(-36deg); animation: cube-spin 40s linear infinite; }
  .cube__face { position: absolute; inset: 0; padding: 10%; background: var(--surface); border: 1px solid var(--accent-line); }
  .cube__face svg { width: 100%; height: 100%; }
  .cube__face--f { transform: translateZ(50cqi); }
  .cube__face--b { transform: rotateY(180deg) translateZ(50cqi); }
  .cube__face--r { transform: rotateY(90deg) translateZ(50cqi); }
  .cube__face--l { transform: rotateY(-90deg) translateZ(50cqi); }
  .cube__face--t { transform: rotateX(90deg) translateZ(50cqi); }
  .cube__face--d { transform: rotateX(-90deg) translateZ(50cqi); }
  @keyframes cube-spin { from { transform: rotateX(-24deg) rotateY(-36deg); } to { transform: rotateX(-24deg) rotateY(324deg); } }
  @media (prefers-reduced-motion: reduce) { .cube { animation: none; } }
</style>
