---
import Prompt from './Prompt.astro';
import { person, projects } from '../data/cv';
const products = projects.slice(0, 5).map((p) => p.name);
---
<section id="top" class="hero container-x" aria-labelledby="hero-title">
  <div class="hero__copy">
    <Prompt cmd="whoami" />
    <h1 id="hero-title" class="hero__title" data-glitch>{person.name}</h1>
    <p class="hero__role mono">
      <span class="text-fg">@{person.handle}</span><span class="text-subtle" aria-hidden="true">/</span><span>{person.role}</span>
      <span class="hero__open">открыт к предложениям</span>
    </p>
    <p class="hero__lede">
      {person.motto[0]}<br />
      <span class="text-fg">{person.motto[1]}</span>
    </p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="#projects">Смотреть проекты <span aria-hidden="true">↓</span></a>
      <a class="btn btn--outline" href="https://github.com/listepo" rel="me noopener" target="_blank">github.com/listepo<span class="sr-only"> (откроется в новой вкладке)</span></a>
    </div>
  </div>

  <div class="hero__stage" aria-hidden="true">
    <div class="hero__3d" id="hero-3d" data-depth="12">
      <div class="globe-fallback"><div class="globe"></div><div class="globe__ring"></div></div>
    </div>
    <div class="hero__pane frost" data-depth="30">
      <div class="pane__tab"><b>zsh</b><span>~/projects</span></div>
      <pre class="hero__pre"><span class="text-accent">❯</span> ls
{products.map((n) => <span class="hero__item">{n}</span>)}
<span class="text-accent">❯</span> <span class="cursor"></span></pre>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid; gap: var(--space-12); align-items: center;
    padding-top: var(--space-16); padding-bottom: var(--space-20);
    min-height: min(860px, calc(100svh - 56px));
  }
  @media (min-width: 960px) { .hero { grid-template-columns: 1.1fr .9fr; gap: var(--space-8); } }

  .hero__title {
    margin-top: var(--space-4);
    font-family: var(--font-mono); font-weight: 600;
    font-size: var(--text-display); line-height: .98; letter-spacing: -0.06em;
  }
  .hero__role { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); margin-top: var(--space-5); font-size: var(--text-base); color: var(--muted); }
  .hero__open {
    display: inline-flex; align-items: center; height: 26px; padding: 0 var(--space-2);
    border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-ink);
    font-size: var(--text-xs); font-weight: 600;
  }
  .hero__lede { margin-top: var(--space-6); max-width: 34rem; font-size: var(--text-lg); line-height: 1.6; color: var(--muted); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }

  .hero__stage { position: relative; aspect-ratio: 1 / 1; width: 100%; max-width: 520px; margin-inline: auto; }
  @media (max-width: 959px) { .hero__stage { max-width: 400px; } }
  /* dark scrim so the rain recedes behind the 3D object */
  .hero__stage::before { content: ""; position: absolute; inset: 4%; border-radius: 50%; background: radial-gradient(closest-side, rgb(11 10 9 / .92), rgb(11 10 9 / .6) 70%, transparent); }
  .hero__3d { position: absolute; inset: 0; display: grid; place-items: center; }
  .hero__3d :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .hero__3d:global(.has-webgl) .globe-fallback { display: none; }

  .hero__pane {
    position: absolute; right: 0; bottom: 6%; width: min(250px, 64%);
    border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg);
    animation: float 9s var(--ease-out) infinite; transform: translate3d(0, var(--float), 0);
  }
  .hero__pre { padding: 12px 16px 14px; font-size: 12.5px; line-height: 1.75; color: var(--fg); white-space: pre-wrap; }
  .hero__item { display: inline-block; margin-right: 12px; }

  /* CSS fallback: dotted sphere + orbit */
  .globe-fallback { position: relative; width: 62%; aspect-ratio: 1; }
  .globe {
    position: absolute; inset: 0; border-radius: 50%;
    background: radial-gradient(rgb(236 231 223 / .55) 1px, transparent 1.6px) 0 0 / 10px 10px;
    mask-image: radial-gradient(circle at 38% 34%, #000 20%, rgb(0 0 0 / .35) 62%, transparent 71%);
  }
  .globe__ring { position: absolute; inset: -8% -14%; border: 1px solid var(--accent-line); border-radius: 50%; transform: rotate(-18deg) scaleY(.32); }
</style>
