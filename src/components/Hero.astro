---
import Prompt from './Prompt.astro';
import { person, projects } from '../data/cv';
const products = projects.filter((p) => p.featured).map((p) => p.name);
---
<section id="top" class="hero container-x" aria-labelledby="hero-title">
  <div class="hero__copy">
    <Prompt cmd="whoami" />
    <h1 id="hero-title" class="hero__title">{person.name}</h1>
    <p class="hero__role mono">
      <span class="text-fg">{person.handle}</span><span class="text-subtle" aria-hidden="true"> · </span><span>{person.role}</span>
      <span class="hero__open"><span class="hero__dot" aria-hidden="true"></span>открыт к предложениям</span>
    </p>
    <p class="hero__lede">
      {person.motto[0]}<br />
      <span class="text-fg">{person.motto[1]}</span>
    </p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="#projects">Смотреть проекты <span aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="https://github.com/listepo" rel="me noopener" target="_blank">github.com/listepo<span class="sr-only"> (откроется в новой вкладке)</span></a>
    </div>
    <ul class="hero__chips" aria-label="Основной стек">
      <li class="chip">Rust</li><li class="chip">Dart · Flutter</li><li class="chip">TypeScript</li><li class="chip">AI-агенты</li>
    </ul>
  </div>

  <div class="hero__stage" aria-hidden="true">
    <div class="hero__3d" id="hero-3d" data-depth="14">
      <div class="cube-fallback">
        <div class="cube">
          <span class="cube__face cube__face--f">&gt;_</span><span class="cube__face cube__face--b"></span>
          <span class="cube__face cube__face--l"></span><span class="cube__face cube__face--r"></span>
          <span class="cube__face cube__face--t"></span><span class="cube__face cube__face--d"></span>
        </div>
      </div>
    </div>
    <div class="term glass" data-depth="34">
      <div class="term__bar"><i></i><i></i><i></i><span>~/pyrlyn</span></div>
      <pre class="term__body"><span class="text-accent">$</span> ls ~/pyrlyn
{products.map((n) => <span class="term__item">{n}/</span>)}
<span class="text-accent">$</span> <span class="cursor"></span></pre>
    </div>
    <div class="badge glass" data-depth="48"><span class="text-accent">&gt;_</span> pyrlyn</div>
  </div>
</section>

<style>
  .hero {
    display: grid; gap: var(--space-12); align-items: center;
    padding-top: var(--space-16); padding-bottom: var(--space-20);
    min-height: min(860px, calc(100svh - 72px));
  }
  @media (min-width: 960px) { .hero { grid-template-columns: 1.1fr .9fr; gap: var(--space-8); padding-top: var(--space-12); } }

  .hero__title {
    margin-top: var(--space-4);
    font-family: var(--font-mono); font-weight: 700;
    font-size: var(--text-display); line-height: 1.0; letter-spacing: -0.05em;
  }
  .hero__role {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4); font-size: var(--text-base); color: var(--muted);
  }
  .hero__open {
    display: inline-flex; align-items: center; gap: var(--space-2); height: 28px; padding: 0 var(--space-3);
    border-radius: var(--radius-full); border: 1px solid rgb(110 231 168 / .3); background: var(--accent-soft);
    color: var(--accent); font-size: var(--text-xs);
  }
  .hero__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px rgb(110 231 168 / .2); }
  .hero__lede { margin-top: var(--space-6); max-width: 34rem; font-size: var(--text-lg); line-height: 1.6; color: var(--muted); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .hero__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-8); }

  /* stage */
  .hero__stage { position: relative; aspect-ratio: 1 / 1; width: 100%; max-width: 520px; margin-inline: auto; perspective: 1200px; }
  @media (max-width: 959px) { .hero__stage { max-width: 420px; } }
  .hero__3d { position: absolute; inset: 0; display: grid; place-items: center; }
  .hero__3d :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .hero__3d:global(.has-webgl) .cube-fallback { display: none; }

  .term {
    position: absolute; left: 0; bottom: 8%; width: min(260px, 62%);
    border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--highlight), var(--shadow-lg);
    animation: float 8s var(--ease-out) infinite; transform: translate3d(0, var(--float), 0);
  }
  .term__bar { display: flex; align-items: center; gap: 6px; padding: 8px 12px; border-bottom: 1px solid var(--line); font-family: var(--font-mono); font-size: 11px; color: var(--subtle); }
  .term__bar i { width: 8px; height: 8px; border-radius: 50%; background: rgb(255 255 255 / .14); }
  .term__bar span { margin-left: auto; }
  .term__body { padding: 12px 14px 14px; font-size: 12.5px; line-height: 1.7; color: var(--fg); white-space: pre-wrap; }
  .term__item { display: inline-block; margin-right: 12px; color: #8fc8ff; }

  .badge {
    position: absolute; right: 4%; top: 10%; padding: 8px 14px; border-radius: var(--radius-full);
    font-family: var(--font-mono); font-size: var(--text-sm); color: var(--fg-strong); box-shadow: var(--highlight), var(--shadow-md);
    animation: float 9s var(--ease-out) -3s infinite; transform: translate3d(0, var(--float), 0);
  }

  /* CSS-3D fallback cube (shown until/unless WebGL mounts) */
  .cube-fallback { width: 44%; aspect-ratio: 1; perspective: 900px; }
  .cube { --s: 100%; position: relative; width: 100%; height: 100%; transform-style: preserve-3d; animation: spin3d 24s linear infinite; transform: rotateX(-22deg) rotateY(-32deg); }
  .cube__face {
    position: absolute; inset: 0; display: grid; place-items: center;
    border: 1px solid rgb(110 231 168 / .55); border-radius: 6px;
    background:
      linear-gradient(rgb(110 231 168 / .07) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(90deg, rgb(110 231 168 / .07) 1px, transparent 1px) 0 0 / 16px 16px,
      rgb(16 19 24 / .55);
    box-shadow: inset 0 0 40px rgb(110 231 168 / .12);
    font-family: var(--font-mono); font-weight: 700; font-size: 2.5rem; color: var(--accent);
  }
  .cube-fallback { container-type: inline-size; --h: 50cqi; }
  .cube__face--f { transform: translateZ(var(--h)); }
  .cube__face--b { transform: rotateY(180deg) translateZ(var(--h)); }
  .cube__face--l { transform: rotateY(-90deg) translateZ(var(--h)); }
  .cube__face--r { transform: rotateY(90deg) translateZ(var(--h)); }
  .cube__face--t { transform: rotateX(90deg) translateZ(var(--h)); }
  .cube__face--d { transform: rotateX(-90deg) translateZ(var(--h)); }
  @media (prefers-reduced-motion: reduce) { .cube { animation: none; } }
</style>
