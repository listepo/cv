---
interface Props {
  /** Wordmark target. The home page scrolls to #top; other pages pass the site base. */
  wordmarkHref?: string;
  /** Numbered section links only exist on the one-page CV. */
  sections?: boolean;
}
const { wordmarkHref = '#top', sections = true } = Astro.props;
const items = [
  { href: '#about', label: 'about', n: '01' },
  { href: '#experience', label: 'experience', n: '02' },
  { href: '#projects', label: 'projects', n: '03' },
  { href: '#contact', label: 'contact', n: '04' },
];
---
<header class="topbar">
  <div class="container-x topbar__inner">
    <a href={wordmarkHref} class="wordmark" aria-label={wordmarkHref.startsWith('#') ? 'Ivan Tuhai — back to top' : 'Ivan Tuhai — home'}>
      <span class="wordmark__text">ivan&nbsp;tuhai</span><span class="wordmark__cursor" aria-hidden="true"></span>
    </a>
    <div class="topbar__right">
    {sections && (
    <nav aria-label="Main navigation">
      <ul class="topbar__list">
        {items.map((i) => (
          <li class={i.label === 'contact' ? '' : 'max-md:hidden'}>
            <a class="nav__link" href={i.href}><span class="nav__n" aria-hidden="true">{i.n}</span>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    )}
    <button type="button" class="theme-toggle" aria-label="Dark theme" aria-pressed="true" title="Switch to light theme" hidden>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <path class="ico-moon" d="M13.2 10.1A5.6 5.6 0 0 1 5.9 2.8a5.6 5.6 0 1 0 7.3 7.3z" fill="currentColor" stroke="none" />
        <g class="ico-sun"><circle cx="8" cy="8" r="2.8" fill="currentColor" stroke="none" /><path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M3.2 12.8l1.1-1.1M11.7 4.3l1.1-1.1" /></g>
      </svg>
    </button>
    <button type="button" class="sound-toggle" aria-label="Enable sound" aria-pressed="false" title="Enable sound" hidden>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square">
        <path d="M2.5 6h2.5l3.5-3v10l-3.5-3h-2.5z" fill="currentColor" stroke="none" />
        <g class="ico-on"><path d="M11 5.5a3.5 3.5 0 0 1 0 5" /><path d="M12.8 3.6a6 6 0 0 1 0 8.8" /></g>
        <g class="ico-off"><path d="M11 6l4 4M15 6l-4 4" /></g>
      </svg>
    </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true"><span></span></div>
</header>
<style>
  .topbar { position: sticky; top: 0; z-index: 50; background: var(--topbar-bg); border-bottom: 1px solid var(--line); }
  .topbar__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); height: 56px; }
  .wordmark { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--fg-strong); letter-spacing: -0.01em; }
  .wordmark__cursor { width: 8px; height: 16px; background: var(--accent); }
  /* Terminal type-on, once per page load, pure CSS. The full text is always in the DOM and in layout
     (it is only clipped), so screen readers get it at once and the width is reserved: no layout shift.
     10 chars × 60 ms after a 100 ms delay; the cursor steps along with the text, then blinks 1 s steps(1). */
  .wordmark__text { display: inline-block; white-space: nowrap; letter-spacing: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .wordmark__text { animation: wm-type 600ms steps(10, end) 100ms backwards; }
    .wordmark__cursor { animation: wm-caret 600ms steps(10, end) 100ms backwards, wm-blink 1s steps(1) 700ms infinite; }
  }
  @keyframes wm-type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes wm-caret { from { transform: translateX(-10ch); } to { transform: none; } }
  @keyframes wm-blink { 50% { opacity: 0; } }
  .topbar__right { display: flex; align-items: center; gap: var(--space-1); }
  .theme-toggle, .sound-toggle {
    display: inline-grid; place-items: center; width: 40px; height: 40px; border: 1px solid transparent; border-radius: var(--radius-sm);
    color: var(--muted); background: transparent; cursor: pointer; transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  .theme-toggle[hidden], .sound-toggle[hidden] { display: none; }
  .theme-toggle:hover { color: var(--fg-strong); border-color: var(--line); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-toggle[aria-pressed="true"] .ico-sun, .theme-toggle[aria-pressed="false"] .ico-moon { display: none; }
  /* attention nudge while sound is off: one small real-looking bounce (4px hop + 1.5px rebound) every 3.5 s */
  @media (prefers-reduced-motion: no-preference) {
    .sound-toggle.is-nudging svg { animation: nudge 3.5s 1.8s infinite; }
  }
  @keyframes nudge {
    0%, 20%, 100% { transform: translateY(0); animation-timing-function: cubic-bezier(.33, 1, .68, 1); }
    5%   { transform: translateY(-4px); animation-timing-function: cubic-bezier(.32, 0, .67, 0); }
    10%  { transform: translateY(0); animation-timing-function: cubic-bezier(.33, 1, .68, 1); }
    13%  { transform: translateY(-1.5px); animation-timing-function: cubic-bezier(.32, 0, .67, 0); }
    16%  { transform: translateY(0); }
  }
  .sound-toggle:hover { color: var(--fg-strong); border-color: var(--line); }
  .sound-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sound-toggle[aria-pressed="true"] { color: var(--accent); }
  .sound-toggle[aria-pressed="true"] .ico-off, .sound-toggle[aria-pressed="false"] .ico-on { display: none; }
  /* scroll progress: 2px lime hairline on the bottom edge of the bar (JS drives scaleX; hidden without JS) */
  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; pointer-events: none; }
  .progress > span { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; }
  .topbar__list { display: flex; align-items: center; gap: var(--space-1); }
  .nav__link {
    position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 10px;
    font-family: var(--font-mono); font-size: var(--text-sm); color: var(--muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav__n { font-size: var(--text-xs); color: var(--subtle); }
  .nav__link::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: 6px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-base) var(--ease-out); }
  .nav__link:hover { color: var(--fg-strong); }
  .nav__link:hover::after, .nav__link[aria-current="true"]::after { transform: scaleX(1); }
  .nav__link[aria-current="true"] { color: var(--fg-strong); }
  @media (prefers-reduced-transparency: reduce) { .topbar { background: var(--bg); } }
</style>
